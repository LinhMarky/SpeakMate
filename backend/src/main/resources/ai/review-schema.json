{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "insufficientData",
    "summary",
    "strengths",
    "weaknesses",
    "recommendedLevel",
    "levelFeedback",
    "grammarCorrections",
    "suggestedWords"
  ],
  "properties": {
    "insufficientData": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "strengths": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3000
    },
    "weaknesses": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3000
    },
    "recommendedLevel": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        null
      ]
    },
    "levelFeedback": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3000
    },
    "grammarCorrections": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "messageId",
          "correctedContent",
          "feedback"
        ],
        "properties": {
          "messageId": {
            "type": "integer",
            "minimum": 1
          },
          "correctedContent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "feedback": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "suggestedWords": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word",
          "meaning",
          "example"
        ],
        "properties": {
          "word": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "example": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      }
    }
  }
}
