# Copy thành .env tại thư mục gốc. Không commit .env hoặc giá trị bí mật.
COMPOSE_PROJECT_NAME=speakmate
BACKEND_HOST_PORT=8081
MYSQL_HOST_PORT=3307
MYSQL_USER=speakmate

# Bắt buộc: tự điền mật khẩu riêng cho Docker; không phải mật khẩu MySQL local.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Bắt buộc: ít nhất 32 byte ngẫu nhiên, mã hóa Base64. Xem README.md.
JWT_SECRET=

# Tùy chọn: để trống vẫn chạy được các API không cần AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Tùy chọn: chỉ cần khi kiểm Google login hoặc gửi email khôi phục mật khẩu.
GOOGLE_CLIENT_ID=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Tùy chọn: chỉ điền khi quản trị viên đã cấp database được chuẩn bị và bảo vệ.
# Để trống giữ MySQL Compose; các biến này không import schema.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
