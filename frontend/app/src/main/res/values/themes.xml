<resources>

    <style name="Base.Theme.SpeakMate"
        parent="Theme.Material3.Dark.NoActionBar">

        <!-- Màu chủ đạo -->
        <item name="colorPrimary">@color/sm_primary</item>
        <item name="colorOnPrimary">@color/sm_text_primary</item>
        <item name="colorSecondary">@color/sm_cyan</item>
        <item name="colorOnSecondary">@color/sm_background</item>

        <!-- Nền và thẻ -->
        <item name="android:colorBackground">@color/sm_background</item>
        <item name="android:windowBackground">@color/sm_background</item>
        <item name="colorOnBackground">@color/sm_text_primary</item>
        <item name="colorSurface">@color/sm_surface</item>
        <item name="colorOnSurface">@color/sm_text_primary</item>

        <!-- Chữ -->
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">@color/sm_text_primary</item>
        <item name="android:textColorSecondary">@color/sm_text_secondary</item>
        <item name="android:colorAccent">@color/sm_cyan</item>

        <!-- Trạng thái lỗi -->
        <item name="colorError">@color/sm_error</item>
        <item name="colorOnError">@color/sm_background</item>

        <!-- Thanh hệ thống -->
        <item name="android:statusBarColor">@color/sm_background</item>
        <item name="android:navigationBarColor">@color/sm_background</item>
        <item name="android:windowLightStatusBar">false</item>

    </style>

    <style name="Theme.SpeakMate" parent="Base.Theme.SpeakMate" />

</resources>