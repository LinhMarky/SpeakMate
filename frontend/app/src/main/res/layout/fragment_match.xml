<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sm_background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCloseMatch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Thoát ghép thẻ"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="✕"
            android:textColor="@color/sm_cyan"
            android:textSize="25sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="Ghép thẻ"
            android:textColor="@color/sm_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRestartMatchTop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Chơi lại"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="↻"
            android:textColor="@color/sm_cyan"
            android:textSize="30sp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvMatchDeckName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/sm_text_secondary"
        android:textSize="14sp" />

    <!-- Java hiển thị một trong ba trạng thái -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Giới thiệu -->
        <ScrollView
            android:id="@+id/panelMatchIntro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_home_feature"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="▦"
                    android:textColor="@color/sm_cyan"
                    android:textSize="60sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:letterSpacing="-0.02"
                    android:text="Bạn đã sẵn sàng?"
                    android:textColor="@color/sm_text_primary"
                    android:textSize="29sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMatchIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:text="Ghép từ tiếng Anh với nghĩa tương ứng."
                    android:textColor="@color/sm_text_secondary"
                    android:textSize="17sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_home_panel"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        android:text="CÁCH CHƠI"
                        android:textColor="@color/sm_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Chọn một từ tiếng Anh, rồi chọn nghĩa tiếng Việt tương ứng."
                        android:textColor="@color/sm_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Ghép sai: −1 giây. Đồng hồ không thấp hơn 0,1 giây."
                        android:textColor="@color/sm_warning"
                        android:textSize="14sp" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStartMatch"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:paddingStart="12dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="0dp"
                    android:text="Bắt đầu chơi"
                    android:textAllCaps="false"
                    android:textColor="@color/sm_background"
                    android:textSize="17sp" />

            </LinearLayout>

        </ScrollView>

        <!-- Bàn chơi -->
        <LinearLayout
            android:id="@+id/panelMatchGame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMatchTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:text="0,1 giây"
                android:textColor="@color/sm_cyan"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMatchPairs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="0 / 6 cặp đã ghép"
                android:textColor="@color/sm_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvMatchFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Chọn hai thẻ tương ứng"
                android:textColor="@color/sm_text_secondary"
                android:textSize="15sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

                <GridLayout
                    android:id="@+id/gridMatchCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />

            </ScrollView>

        </LinearLayout>

        <!-- Kết quả -->
        <ScrollView
            android:id="@+id/panelMatchResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_home_feature"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="✓"
                    android:textColor="@color/sm_success"
                    android:textSize="52sp" />

                <TextView
                    android:id="@+id/tvMatchResultTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:letterSpacing="-0.02"
                    android:lineSpacingExtra="4dp"
                    android:text="Hoàn thành!"
                    android:textColor="@color/sm_text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMatchResultTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/sm_cyan"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_home_panel"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="KỶ LỤC CỦA BỘ THẺ"
                        android:textColor="@color/sm_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMatchBest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/sm_warning"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMatchResultDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/sm_text_secondary"
                        android:textSize="15sp" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPlayMatchAgain"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:paddingStart="12dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="0dp"
                    android:text="Chơi lại"
                    android:textAllCaps="false"
                    android:textColor="@color/sm_background"
                    android:textSize="17sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBackMatchDeck"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_home_button_secondary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:paddingStart="12dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="0dp"
                    android:text="Về bộ thẻ"
                    android:textAllCaps="false"
                    android:textColor="@color/sm_cyan"
                    android:textSize="16sp" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</LinearLayout>