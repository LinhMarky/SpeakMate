<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12112C"
    android:padding="20dp">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnCloseMatch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="✕"
            android:textColor="#F5F3FF"
            android:textSize="25sp"
            android:contentDescription="Thoát ghép thẻ"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Ghép thẻ"
            android:textColor="#F5F3FF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRestartMatchTop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="↻"
            android:textColor="#20D9F4"
            android:textSize="30sp"
            android:contentDescription="Chơi lại"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvMatchDeckName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:textColor="#B8B5D6"
        android:textSize="14sp" />

    <!-- Chỉ một trong ba trạng thái được hiển thị -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. Giới thiệu -->
        <ScrollView
            android:id="@+id/panelMatchIntro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:text="▦"
                    android:textColor="#20D9F4"
                    android:textSize="60sp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:text="Bạn đã sẵn sàng?"
                    android:textColor="#F5F3FF"
                    android:textSize="29sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMatchIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Ghép từ tiếng Anh với nghĩa tương ứng."
                    android:textColor="#B8B5D6"
                    android:textSize="17sp"
                    android:lineSpacingExtra="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CÁCH CHƠI"
                        android:textColor="#9692B5"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Chọn một từ tiếng Anh, rồi chọn nghĩa tiếng Việt tương ứng."
                        android:textColor="#F5F3FF"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Ghép sai: −1 giây. Đồng hồ không thấp hơn 0,1 giây."
                        android:textColor="#FFC66D"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStartMatch"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:text="Bắt đầu chơi"
                    android:textAllCaps="false"
                    android:textColor="#12112C"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </ScrollView>

        <!-- 2. Bàn chơi -->
        <LinearLayout
            android:id="@+id/panelMatchGame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMatchTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="0,1 giây"
                android:textColor="#F5F3FF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMatchPairs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="0 / 6 cặp đã ghép"
                android:textColor="#9692B5"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvMatchFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Chọn hai thẻ tương ứng"
                android:textColor="#B8B5D6"
                android:textSize="15sp"
                android:accessibilityLiveRegion="polite" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never">

                <GridLayout
                    android:id="@+id/gridMatchCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />

            </ScrollView>

        </LinearLayout>

        <!-- 3. Kết quả -->
        <ScrollView
            android:id="@+id/panelMatchResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:text="✓"
                    android:textColor="#35D6A0"
                    android:textSize="52sp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvMatchResultTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center"
                    android:text="Hoàn thành!"
                    android:textColor="#F5F3FF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMatchResultTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:textColor="#20D9F4"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="KỶ LỤC CỦA BỘ THẺ"
                        android:textColor="#9692B5"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvMatchBest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#FFC66D"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMatchResultDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="#B8B5D6"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPlayMatchAgain"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:text="Chơi lại"
                    android:textAllCaps="false"
                    android:textColor="#12112C"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBackMatchDeck"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:backgroundTint="@null"
                    android:text="Về bộ thẻ"
                    android:textAllCaps="false"
                    android:textColor="#20D9F4"
                    android:textSize="16sp" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</LinearLayout>