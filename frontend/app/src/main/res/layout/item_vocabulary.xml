<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_home_panel"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvVocabularyWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:letterSpacing="-0.02"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/sm_cyan"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVocabularyMeaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/sm_text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvVocabularyExample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/sm_text_secondary"
        android:textSize="14sp"
        android:textStyle="italic" />

</LinearLayout>