<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sm_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:focusableInTouchMode="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Hình hoàn thành buổi luyện -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="12dp"
            android:importantForAccessibility="noHideDescendants">

            <ImageView
                android:layout_width="144dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sm_complete" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|center_horizontal"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sm_sparkles"
                android:translationX="66dp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sm_sparkles"
                android:translationX="-66dp" />

        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:text="Bạn đã hoàn thành buổi luyện!"
            android:textColor="@color/sm_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResultTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/sm_cyan"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvResultStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/sm_text_secondary"
            android:textSize="14sp" />

        <!-- Trình độ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_sm_learning_goal"
                android:drawablePadding="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="36dp"
                android:text="Trình độ thể hiện"
                android:textColor="@color/sm_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvResultEstimatedLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/sm_cyan"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultLevelDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/sm_text_secondary"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Điểm mạnh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_sm_stat_remembered"
                android:drawablePadding="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="36dp"
                android:text="Điểm mạnh"
                android:textColor="@color/sm_success"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvResultStrengths"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/sm_text_primary"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Điểm cần cải thiện -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_sm_stat_remaining"
                android:drawablePadding="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="36dp"
                android:text="Điểm cần cải thiện"
                android:textColor="@color/sm_warning"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvResultWeaknesses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/sm_text_primary"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/sm_divider"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Sửa lỗi ngữ pháp"
                android:textColor="@color/sm_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvResultGrammar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/sm_text_secondary"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Từ vựng -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:drawableStart="@drawable/ic_sm_stat_words"
            android:drawablePadding="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:minHeight="36dp"
            android:text="Từ vựng tham khảo"
            android:textColor="@color/sm_text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvResultVocabularyNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/sm_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/resultVocabularyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvResultSelectedCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/sm_cyan"
            android:textSize="14sp" />

        <!-- Tạo bộ thẻ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Mang từ mới vào bộ thẻ"
                android:textColor="@color/sm_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Chọn các từ phía trên và đặt tên bộ thẻ để ôn tập sau."
                android:textColor="@color/sm_text_secondary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etResultDeckName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_home_button_secondary"
                android:backgroundTint="@null"
                android:gravity="center_vertical"
                android:hint="Tên bộ thẻ"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingTop="0dp"
                android:paddingEnd="14dp"
                android:paddingBottom="0dp"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textColor="@color/sm_text_primary"
                android:textColorHint="@color/sm_text_hint"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCreateResultDeck"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/sm_cyan"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingTop="0dp"
                android:paddingEnd="16dp"
                android:paddingBottom="0dp"
                android:text="Tạo bộ flashcard"
                android:textAllCaps="false"
                android:textColor="@color/sm_on_primary"
                android:textSize="16sp"
                android:drawableStart="@drawable/ic_sm_bookmark_white"
                android:drawablePadding="10dp"/>

            <TextView
                android:id="@+id/tvResultDeckStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/sm_success"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenResultDeck"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_button_secondary"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingTop="0dp"
                android:paddingEnd="16dp"
                android:paddingBottom="0dp"
                android:text="Mở bộ thẻ vừa tạo"
                android:textAllCaps="false"
                android:textColor="@color/sm_cyan"
                android:textSize="16sp"
                android:visibility="gone"
                android:drawableStart="@drawable/ic_sm_nav_book"
                android:drawableTint="@color/sm_primary"
                android:drawablePadding="10dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="4dp"
            android:text="Phiên demo: chưa có đánh giá AI. Từ vựng hiện được chuẩn bị sẵn theo chủ đề."
            android:textColor="@color/sm_text_hint"
            android:textSize="12sp" />

        <!-- Điều hướng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnViewResultConversation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_home_button_secondary"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingTop="0dp"
                android:paddingEnd="16dp"
                android:paddingBottom="0dp"
                android:text="Xem lại hội thoại"
                android:textAllCaps="false"
                android:textColor="@color/sm_cyan"
                android:textSize="16sp"
                android:drawableStart="@drawable/ic_sm_nav_mic"
                android:drawableTint="@color/sm_primary"
                android:drawablePadding="10dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBackToPractice"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/sm_cyan"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingTop="0dp"
                android:paddingEnd="16dp"
                android:paddingBottom="0dp"
                android:text="Chọn bài luyện tiếp"
                android:textAllCaps="false"
                android:textColor="@color/sm_background"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnResultHome"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_button_secondary"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingTop="0dp"
                android:paddingEnd="16dp"
                android:paddingBottom="0dp"
                android:text="Về trang chủ"
                android:textAllCaps="false"
                android:textColor="@color/sm_cyan"
                android:textSize="16sp"
                android:drawableStart="@drawable/ic_sm_nav_home"
                android:drawableTint="@color/sm_primary"
                android:drawablePadding="10dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>