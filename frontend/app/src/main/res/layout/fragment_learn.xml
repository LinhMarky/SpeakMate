<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12112C"
    android:padding="20dp">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnCloseLearn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="25sp"
            android:textColor="#F5F3FF"
            android:contentDescription="Thoát phần học"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvLearnHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Luyện từ vựng"
            android:textColor="#F5F3FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLearnCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 3"
            android:textColor="#20D9F4"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressLearn"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#20D9F4"
        android:progressBackgroundTint="#302E50" />

    <ScrollView
        android:id="@+id/scrollLearn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Phần làm bài -->
            <LinearLayout
                android:id="@+id/panelLearnQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLearnDeckName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B8B5D6"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bạn nhớ từ này chứ?"
                    android:textColor="#F5F3FF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Thẻ câu hỏi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="210dp"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NGHĨA TIẾNG VIỆT"
                        android:textColor="#9692B5"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:id="@+id/tvLearnMeaning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:textColor="#F5F3FF"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Nhập từ tiếng Anh tương ứng"
                    android:textColor="#B8B5D6"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etLearnAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_card"
                    android:backgroundTint="@null"
                    android:hint="Câu trả lời của bạn..."
                    android:textColor="#F5F3FF"
                    android:textColorHint="#9692B5"
                    android:textSize="18sp"
                    android:inputType="text|textNoSuggestions"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:saveEnabled="false" />

                <!-- Phản hồi sau khi nộp -->
                <LinearLayout
                    android:id="@+id/panelLearnFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/bg_card"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvLearnFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:accessibilityLiveRegion="polite" />

                    <TextView
                        android:id="@+id/tvLearnCorrectAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#F5F3FF"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvLearnExample"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#B8B5D6"
                        android:textSize="15sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCheckLearn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:text="Kiểm tra"
                    android:textAllCaps="false"
                    android:textColor="#12112C"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNextLearn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:text="Tiếp tục"
                    android:textAllCaps="false"
                    android:textColor="#12112C"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Không phân biệt chữ hoa, chữ thường."
                    android:textColor="#9692B5"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Phần kết quả -->
            <LinearLayout
                android:id="@+id/panelLearnResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="20dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="220dp"
                    android:layout_height="220dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressLearnAccuracy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        app:indicatorSize="200dp"
                        app:indicatorInset="0dp"
                        app:trackThickness="10dp"
                        app:indicatorColor="#A49AFF"
                        app:trackColor="#302E50" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvLearnPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#F5F3FF"
                            android:textSize="44sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Chính xác"
                            android:textColor="#B8B5D6"
                            android:textSize="16sp" />

                    </LinearLayout>

                </FrameLayout>

                <TextView
                    android:id="@+id/tvLearnResultTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Tốt lắm!"
                    android:textColor="#F5F3FF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLearnResultSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="#B8B5D6"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRestartLearn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:text="Bắt đầu lại"
                    android:textAllCaps="false"
                    android:textColor="#12112C"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBackLearnDeck"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:backgroundTint="@null"
                    android:text="Về bộ thẻ"
                    android:textAllCaps="false"
                    android:textColor="#20D9F4"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Xem lại câu trả lời"
                    android:textColor="#F5F3FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/learnAnswerList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>