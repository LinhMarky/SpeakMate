<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cbGeneratedWordSelected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:buttonTint="@color/sm_cyan"
        android:fontFamily="sans-serif-medium"
        android:minHeight="48dp"
        android:saveEnabled="false"
        android:text="Giữ từ này"
        android:textColor="@color/sm_cyan"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:labelFor="@id/etGeneratedWord"
        android:text="Từ tiếng Anh"
        android:textColor="@color/sm_text_secondary"
        android:textSize="12sp" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etGeneratedWord"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_home_button_secondary"
        android:backgroundTint="@null"
        android:gravity="center_vertical"
        android:hint="Nhập từ tiếng Anh"
        android:imeOptions="actionNext"
        android:inputType="text"
        android:maxLength="100"
        android:paddingStart="14dp"
        android:paddingTop="0dp"
        android:paddingEnd="14dp"
        android:paddingBottom="0dp"
        android:saveEnabled="false"
        android:singleLine="true"
        android:textColor="@color/sm_text_primary"
        android:textColorHint="@color/sm_text_hint"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:labelFor="@id/etGeneratedMeaning"
        android:text="Nghĩa tiếng Việt"
        android:textColor="@color/sm_text_secondary"
        android:textSize="12sp" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etGeneratedMeaning"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_home_button_secondary"
        android:backgroundTint="@null"
        android:gravity="center_vertical"
        android:hint="Nhập nghĩa tiếng Việt"
        android:imeOptions="actionNext"
        android:inputType="textCapSentences"
        android:maxLength="200"
        android:paddingStart="14dp"
        android:paddingTop="0dp"
        android:paddingEnd="14dp"
        android:paddingBottom="0dp"
        android:saveEnabled="false"
        android:singleLine="true"
        android:textColor="@color/sm_text_primary"
        android:textColorHint="@color/sm_text_hint"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:labelFor="@id/etGeneratedExample"
        android:text="Câu ví dụ · Không bắt buộc"
        android:textColor="@color/sm_text_secondary"
        android:textSize="12sp" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etGeneratedExample"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_home_button_secondary"
        android:backgroundTint="@null"
        android:gravity="center_vertical"
        android:hint="Nhập câu ví dụ"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLength="500"
        android:paddingStart="14dp"
        android:paddingTop="0dp"
        android:paddingEnd="14dp"
        android:paddingBottom="0dp"
        android:saveEnabled="false"
        android:singleLine="true"
        android:textColor="@color/sm_text_primary"
        android:textColorHint="@color/sm_text_hint"
        android:textSize="15sp" />

</LinearLayout>