<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#12112C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCloseStudy"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#F5F3FF"
            android:textSize="26sp"
            android:contentDescription="Thoát phần học"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvStudyProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="0/0 thẻ"
            android:textColor="#B8B5D6"
            android:textSize="15sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvStudyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Học flashcard"
        android:textColor="#F5F3FF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressStudy"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#20D9F4"
        android:progressBackgroundTint="#302E50" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNotRememberedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chưa thuộc: 0"
            android:textColor="#FFC66D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRememberedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Đã nhớ: 0"
            android:textColor="#35D6A0"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/studyStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/studyCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#24233F"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Thẻ từ vựng. Chạm để xem nghĩa">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvStudyWord"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Vocabulary"
                        android:textColor="#F5F3FF"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStudyMeaning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:textColor="#20D9F4"
                        android:textSize="23sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvStudyExample"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:textColor="#B8B5D6"
                        android:textSize="17sp"
                        android:lineSpacingExtra="4dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvFlipHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:gravity="center"
                        android:text="Chạm thẻ để xem nghĩa"
                        android:textColor="#9692B5"
                        android:textSize="14sp" />

                </LinearLayout>

            </ScrollView>

            <TextView
                android:id="@+id/tvSwipeLabel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="20dp"
                android:background="#24233F"
                android:textSize="32sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:importantForAccessibility="no" />

        </FrameLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/tvSwipeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="← Chưa thuộc  •  Đã nhớ →"
        android:textColor="#B8B5D6"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/studyActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNotRemembered"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Chưa thuộc"
            android:textAllCaps="false"
            android:textColor="#12112C"
            android:textSize="15sp"
            android:backgroundTint="#FFC66D" />

        <Button
            android:id="@+id/btnRemembered"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Đã nhớ"
            android:textAllCaps="false"
            android:textColor="#12112C"
            android:textSize="15sp"
            android:backgroundTint="#35D6A0" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/studyResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvStudyResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Hoàn thành lượt học!"
                android:textColor="#F5F3FF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStudyResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:lineSpacingExtra="10dp"
                android:textColor="#B8B5D6"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnRestartStudy"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="Học lại"
                android:textAllCaps="false"
                android:textColor="#12112C"
                android:textSize="16sp"
                android:backgroundTint="#20D9F4" />

            <Button
                android:id="@+id/btnBackToDeck"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="Về bộ thẻ"
                android:textAllCaps="false"
                android:textColor="#F5F3FF"
                android:textSize="16sp"
                android:backgroundTint="#302E50" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Tiến độ từng từ được lưu trên thiết bị."
                android:textColor="#9692B5"
                android:textSize="13sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>