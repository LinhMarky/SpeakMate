<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sm_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Luyện nói với AI"
                android:textColor="@color/sm_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Chọn trình độ và tình huống bạn muốn luyện tập."
                android:textColor="@color/sm_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Chọn trình độ"
                android:textColor="@color/sm_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Chọn mức luyện từ A1 đến B2."
                android:textColor="@color/sm_text_hint"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <RadioGroup
                    android:id="@+id/rgLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:saveEnabled="false">

                    <RadioButton
                        android:id="@+id/rbA1"
                        android:layout_width="64dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_option"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="4dp"
                        android:saveEnabled="false"
                        android:text="A1"
                        android:textColor="@color/sm_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbA2"
                        android:layout_width="64dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_option"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="4dp"
                        android:saveEnabled="false"
                        android:text="A2"
                        android:textColor="@color/sm_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbB1"
                        android:layout_width="64dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_option"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="4dp"
                        android:saveEnabled="false"
                        android:text="B1"
                        android:textColor="@color/sm_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbB2"
                        android:layout_width="64dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_option"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="4dp"
                        android:saveEnabled="false"
                        android:text="B2"
                        android:textColor="@color/sm_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbC1"
                        android:visibility="gone"
                        android:layout_width="64dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_option"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="4dp"
                        android:saveEnabled="false"
                        android:text="C1"
                        android:textColor="@color/sm_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbC2"
                        android:visibility="gone"
                        android:layout_width="64dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_option"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="4dp"
                        android:saveEnabled="false"
                        android:text="C2"
                        android:textColor="@color/sm_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </RadioGroup>

            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvLevelDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:minHeight="48dp"
                android:textColor="@color/sm_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Chọn chủ đề"
                android:textColor="@color/sm_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:saveEnabled="false">

                <RadioButton
                    android:id="@+id/rbIntroduction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_option"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_sm_topic_intro"
                    android:drawableEnd="@drawable/selector_sm_topic_end"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="4dp"
                    android:minHeight="80dp"
                    android:paddingStart="12dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="14dp"
                    android:saveEnabled="false"
                    android:text="Introducing Yourself\nGiới thiệu bản thân"
                    android:textColor="@color/sm_text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbFood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_option"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_sm_topic_food"
                    android:drawableEnd="@drawable/selector_sm_topic_end"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="4dp"
                    android:minHeight="80dp"
                    android:paddingStart="12dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="14dp"
                    android:saveEnabled="false"
                    android:text="Ordering Food\nGọi món tại nhà hàng"
                    android:textColor="@color/sm_text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbTravel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_option"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_sm_topic_travel"
                    android:drawableEnd="@drawable/selector_sm_topic_end"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="4dp"
                    android:minHeight="80dp"
                    android:paddingStart="12dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="14dp"
                    android:saveEnabled="false"
                    android:text="Travel\nDu lịch và di chuyển"
                    android:textColor="@color/sm_text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbUniversity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_option"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_sm_topic_university"
                    android:drawableEnd="@drawable/selector_sm_topic_end"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="4dp"
                    android:minHeight="80dp"
                    android:paddingStart="12dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="14dp"
                    android:saveEnabled="false"
                    android:text="University Life\nCuộc sống đại học"
                    android:textColor="@color/sm_text_primary"
                    android:textSize="14sp" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="4dp"
                android:id="@+id/tvSpeakingState"
                android:text="Đang tải chủ đề…"
                android:textColor="@color/sm_text_hint"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBeginConversation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_primary"
        android:backgroundTint="@null"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="0dp"
        android:paddingStart="16dp"
        android:paddingTop="0dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp"
        android:text="Bắt đầu hội thoại"
        android:textAllCaps="false"
        android:textColor="@color/sm_background"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
