<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@id/tvDeckName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/sm_text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@id/tvDeckInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/sm_text_secondary"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@id/progressDeck"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progressTint="@color/sm_cyan"
        android:progressBackgroundTint="@color/sm_border" />

    <TextView
        android:id="@id/tvDeckProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/sm_text_hint"
        android:textSize="12sp" />

</LinearLayout>
