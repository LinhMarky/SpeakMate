<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sm_background"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnBackChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Quay lại"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="‹"
            android:textColor="@color/sm_cyan"
            android:textSize="36sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tvChatTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="-0.02"
                android:textColor="@color/sm_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/sm_cyan"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnEndChat"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_sm_chat_end"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Kết thúc"
            android:textColor="@color/sm_error"
            android:textSize="13sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/sm_divider"
        android:importantForAccessibility="no" />

    <!-- Trạng thái và tùy chọn nghe -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="3dp"
            android:id="@+id/tvChatState"
            android:text="Đang tải hội thoại…"
            android:textColor="@color/sm_text_hint"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cbChatAutoSpeak"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:buttonTint="@color/sm_cyan"
            android:contentDescription="Tự đọc câu trả lời tiếng Anh"
            android:fontFamily="sans-serif-medium"
            android:saveEnabled="false"
            android:text="Nghe"
            android:textColor="@color/sm_cyan"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Tin nhắn -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/messageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />

    </ScrollView>

    <!-- Java ẩn toàn bộ vùng này khi xem lại hội thoại -->
    <LinearLayout
        android:id="@+id/chatComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sm_background"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnVoiceInput"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@null"
                android:contentDescription="Nhấn giữ để nói tiếng Anh, thả tay để kết thúc"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_home_button_secondary"
                android:backgroundTint="@null"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:hint="Nhập tiếng Anh..."
                android:imeOptions="actionDone"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="52dp"
                android:padding="14dp"
                android:saveEnabled="false"
                android:textColor="@color/sm_text_primary"
                android:textColorHint="@color/sm_text_hint"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSendMessage"
                android:layout_width="64dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/sm_cyan"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingTop="0dp"
                android:paddingEnd="8dp"
                android:paddingBottom="0dp"
                android:text="Gửi"
                android:textAllCaps="false"
                android:textColor="@color/sm_background"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvVoiceInputHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:lineSpacingExtra="3dp"
            android:text="Giữ micro để nói tiếng Anh, thả tay để kết thúc."
            android:textColor="@color/sm_text_hint"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
