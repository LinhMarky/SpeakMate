<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12112C">

    <!-- Thanh tiêu đề cố định -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBackDeck"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="‹"
            android:textColor="#F5F3FF"
            android:textSize="40sp"
            android:contentDescription="Quay về thư viện"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Bộ thẻ"
            android:textColor="#F5F3FF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnManageDeck"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="⋯"
            android:textColor="#B8B5D6"
            android:textSize="30sp"
            android:contentDescription="Quản lý bộ thẻ"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollDeckDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- Thẻ xem trước -->
            <FrameLayout
                android:id="@+id/deckPreviewCard"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Thẻ xem trước. Chạm để lật">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="62dp">

                    <TextView
                        android:id="@+id/tvPreviewSide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TỪ TIẾNG ANH"
                        android:textColor="#9692B5"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:id="@+id/tvPreviewWord"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="Xem trước từ vựng"
                        android:textColor="#F5F3FF"
                        android:textSize="29sp"
                        android:textStyle="bold"
                        android:maxLines="4"
                        android:ellipsize="end" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="20dp"
                    android:text="Chạm để lật"
                    android:textColor="#9692B5"
                    android:textSize="13sp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/btnExpandDeckPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="⛶"
                    android:textColor="#20D9F4"
                    android:textSize="14sp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="Mở thẻ ghi nhớ toàn màn hình"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

            <!-- Chuyển thẻ xem trước -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnPreviousPreview"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#B8B5D6"
                    android:textSize="32sp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Thẻ trước"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvPreviewPosition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0 / 0"
                    android:textColor="#9692B5"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnNextPreview"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#B8B5D6"
                    android:textSize="32sp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Thẻ tiếp theo"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Thông tin bộ thẻ -->
            <TextView
                android:id="@+id/tvDetailDeckName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tên bộ thẻ"
                android:textColor="#F5F3FF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailDeckInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#B8B5D6"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Chọn cách học"
                android:textColor="#F5F3FF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Luyện nhớ, tự kiểm tra và ghép từ."
                android:textColor="#9692B5"
                android:textSize="14sp" />

            <!-- Giữ ID cũ để Java hiện tại vẫn mở phần học thẻ -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStudyDeck"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="start|center_vertical"
                android:background="@drawable/bg_card"
                android:backgroundTint="@null"
                android:text="▣    Thẻ ghi nhớ"
                android:textAllCaps="false"
                android:textColor="#F5F3FF"
                android:textSize="18sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLearnDeck"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="start|center_vertical"
                android:background="@drawable/bg_card"
                android:backgroundTint="@null"
                android:text="✎    Học"
                android:textAllCaps="false"
                android:textColor="#F5F3FF"
                android:textSize="18sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMatchDeck"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="start|center_vertical"
                android:background="@drawable/bg_card"
                android:backgroundTint="@null"
                android:text="▦    Ghép thẻ"
                android:textAllCaps="false"
                android:textColor="#F5F3FF"
                android:textSize="18sp" />

            <!-- Danh sách từ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Từ vựng trong bộ"
                android:textColor="#F5F3FF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>