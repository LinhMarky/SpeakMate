<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sm_background"
    android:orientation="vertical">

    <!-- Thanh tiêu đề cố định -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBackDeck"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Quay về thư viện"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="‹"
            android:textColor="@color/sm_cyan"
            android:textSize="40sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="Bộ thẻ"
            android:textColor="@color/sm_text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnManageDeck"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Quản lý bộ thẻ"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="⋯"
            android:textColor="@color/sm_text_secondary"
            android:textSize="30sp"
            android:visibility="gone" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollDeckDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- Thẻ xem trước -->
            <FrameLayout
                android:id="@+id/deckPreviewCard"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_feature"
                android:clickable="true"
                android:contentDescription="Thẻ xem trước. Chạm để lật"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="62dp">

                    <TextView
                        android:id="@+id/tvPreviewSide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:letterSpacing="0.12"
                        android:text="TỪ TIẾNG ANH"
                        android:textColor="@color/sm_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPreviewWord"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:letterSpacing="-0.02"
                        android:maxLines="4"
                        android:text="Xem trước từ vựng"
                        android:textColor="@color/sm_text_primary"
                        android:textSize="29sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="20dp"
                    android:importantForAccessibility="no"
                    android:text="Chạm để lật"
                    android:textColor="@color/sm_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnExpandDeckPreview"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Mở thẻ ghi nhớ toàn màn hình"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="⛶"
                    android:textColor="@color/sm_cyan"
                    android:textSize="26sp" />

            </FrameLayout>

            <!-- Chuyển thẻ xem trước -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPreviousPreview"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Thẻ trước"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="‹"
                    android:textColor="@color/sm_text_secondary"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/tvPreviewPosition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="0 / 0"
                    android:textColor="@color/sm_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnNextPreview"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Thẻ tiếp theo"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="›"
                    android:textColor="@color/sm_text_secondary"
                    android:textSize="32sp" />

            </LinearLayout>

            <!-- Thông tin bộ thẻ -->
            <TextView
                android:id="@+id/tvDetailDeckName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:letterSpacing="-0.02"
                android:text="Tên bộ thẻ"
                android:textColor="@color/sm_text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailDeckInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/sm_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif"
                android:text="Chọn cách học"
                android:textColor="@color/sm_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Luyện nhớ, tự kiểm tra và ghép từ."
                android:textColor="@color/sm_text_secondary"
                android:textSize="14sp" />

            <!-- Ba chế độ học: giữ nguyên thứ tự và ID -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStudyDeck"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_home_button_secondary"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:paddingStart="20dp"
                android:paddingTop="0dp"
                android:paddingEnd="20dp"
                android:paddingBottom="0dp"
                android:text="▣    Thẻ ghi nhớ"
                android:textAllCaps="false"
                android:textColor="@color/sm_cyan"
                android:textSize="18sp"
                android:drawableStart="@drawable/ic_sm_nav_book"
                android:drawableTint="@color/sm_primary"
                android:drawablePadding="12dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLearnDeck"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_button_secondary"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:paddingStart="20dp"
                android:paddingTop="0dp"
                android:paddingEnd="20dp"
                android:paddingBottom="0dp"
                android:text="✎    Học"
                android:textAllCaps="false"
                android:textColor="@color/sm_primary"
                android:textSize="18sp"
                android:drawableStart="@drawable/ic_sm_quiz"
                android:drawablePadding="12dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMatchDeck"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_button_secondary"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:paddingStart="20dp"
                android:paddingTop="0dp"
                android:paddingEnd="20dp"
                android:paddingBottom="0dp"
                android:text="▦    Ghép thẻ"
                android:textAllCaps="false"
                android:textColor="@color/sm_success"
                android:textSize="18sp"
                android:drawableStart="@drawable/ic_sm_match"
                android:drawablePadding="12dp"/>

            <!-- Danh sách từ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="sans-serif"
                android:text="Từ vựng trong bộ"
                android:textColor="@color/sm_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>