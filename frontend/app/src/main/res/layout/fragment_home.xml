<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sm_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Thương hiệu -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:letterSpacing="-0.03"
            android:text="SpeakMate"
            android:textColor="@color/sm_cyan"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Luyện nói tự tin · Ghi nhớ từ vựng"
            android:textColor="@color/sm_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="-0.02"
            android:text="Chào Khoa!"
            android:textColor="@color/sm_text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Hôm nay bạn muốn học gì?"
            android:textColor="@color/sm_text_secondary"
            android:textSize="15sp" />

        <!-- 1. Luyện nói cùng mascot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_sm_home_hero"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="176dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="6dp"
            android:paddingBottom="18dp">

            <!-- Nội dung và nút bên trái -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="-0.02"
                    android:text="Luyện nói cùng AI"
                    android:textColor="@color/sm_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Thực hành hội thoại theo chủ đề và trình độ."
                    android:textColor="#E2E4FF"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStartSpeaking"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_sm_button_neon"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="8dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="0dp"
                    android:text="Bắt đầu  →"
                    android:textAllCaps="false"
                    android:textColor="@color/sm_text_primary"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- Mascot bên phải -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="148dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="noHideDescendants">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="8dp"
                    android:clickable="false"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sm_sparkles" />

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="132dp"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sm_mascot_wave" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="3dp"
                    android:clickable="false"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sm_sparkles" />

            </FrameLayout>

        </LinearLayout>
        <!-- 2. Flashcard -->
        <LinearLayout
            android:id="@+id/cardFlashcards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_home_panel"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="false"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sm_flashcards" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Flashcard từ vựng"
                        android:textColor="@color/sm_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Ghi nhớ từ mới qua thẻ học thông minh."
                        android:textColor="@color/sm_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="›"
                    android:textColor="@color/sm_text_secondary"
                    android:textSize="30sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 3. Tiến độ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="sans-serif"
            android:text="Tiến độ của bạn"
            android:textColor="@color/sm_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="HÀNH TRÌNH TỪ VỰNG"
                    android:textColor="@color/sm_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvHomeProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="0%"
                    android:textColor="@color/sm_cyan"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressHomeVocabulary"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@null"
                android:progressDrawable="@drawable/progress_sm_vocabulary"
                android:progressTint="@null"
                android:secondaryProgressTint="@null" />

            <TextView
                android:id="@+id/tvHomeProgressDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:text="Đang đọc tiến độ..."
                android:textColor="@color/sm_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Thống kê hàng 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvHomeDeckCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_sm_stat_decks"
                    android:drawablePadding="10dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical"
                    android:minHeight="36dp"
                    android:text="0"
                    android:textColor="@color/sm_cyan"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Bộ thẻ"
                    android:textColor="@color/sm_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvHomeTotalWordCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_sm_stat_words"
                    android:drawablePadding="10dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical"
                    android:minHeight="36dp"
                    android:text="0"
                    android:textColor="#BEA8FF"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tổng từ vựng"
                    android:textColor="@color/sm_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Thống kê hàng 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvLearnedWordCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_sm_stat_remembered"
                    android:drawablePadding="10dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical"
                    android:minHeight="36dp"
                    android:text="0"
                    android:textColor="@color/sm_success"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Từ đã nhớ"
                    android:textColor="@color/sm_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvHomeRemainingWordCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_sm_stat_remaining"
                    android:drawablePadding="10dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical"
                    android:minHeight="36dp"
                    android:text="0"
                    android:textColor="@color/sm_warning"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Từ cần học"
                    android:textColor="@color/sm_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>
        <TextView
            android:id="@+id/tvHomeSuggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/sm_text_secondary"
            android:textSize="14sp" />

        <!-- 4. Kế hoạch học -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="sans-serif"
            android:text="Kế hoạch học"
            android:textColor="@color/sm_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sm_learning_goal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Mục tiêu của bạn"
                        android:textColor="@color/sm_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Từng bước tiến bộ mỗi ngày"
                        android:textColor="@color/sm_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/sm_divider"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvHomePracticeLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_sm_stat_words"
                android:drawablePadding="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:textColor="#C3B1FF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHomeDailyGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_sm_stat_remaining"
                android:drawablePadding="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:textColor="@color/sm_text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="4dp"
                android:text="Duy trì một chút luyện tập mỗi ngày."
                android:textColor="@color/sm_text_secondary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHomeEditLearningPlan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_sm_button_neon"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingTop="0dp"
                android:paddingEnd="12dp"
                android:paddingBottom="0dp"
                android:text="Điều chỉnh kế hoạch →"
                android:textAllCaps="false"
                android:textColor="@color/sm_text_primary"
                android:textSize="14sp" />

        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Tiến độ từ vựng được lưu trên thiết bị."
            android:textColor="@color/sm_text_hint"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>