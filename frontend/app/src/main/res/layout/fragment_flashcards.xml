<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sm_background"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:letterSpacing="-0.02"
        android:text="Bộ thẻ của tôi"
        android:textColor="@color/sm_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:text="Học và ôn tập từ vựng theo chủ đề."
        android:textColor="@color/sm_text_secondary"
        android:textSize="14sp" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etSearchDeck"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_home_button_secondary"
        android:backgroundTint="@null"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:hint="Tìm tên bộ thẻ..."
        android:imeOptions="actionDone"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingTop="0dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp"
        android:singleLine="true"
        android:textColor="@color/sm_text_primary"
        android:textColorHint="@color/sm_text_hint"
        android:textSize="15sp"
        android:drawableStart="@drawable/ic_sm_search"
        android:drawablePadding="10dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCreateDeckAi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_primary"
        android:backgroundTint="@null"
        android:drawableStart="@drawable/ic_sm_ai_white"
        android:drawablePadding="10dp"
        android:elevation="0dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="52dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:text="Tạo bộ thẻ bằng AI"
        android:textAllCaps="false"
        android:textColor="@color/sm_on_primary"
        android:textSize="15sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCreateDeckManual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_home_button_secondary"
        android:backgroundTint="@null"
        android:drawableStart="@drawable/ic_sm_add"
        android:drawablePadding="10dp"
        android:elevation="0dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="52dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:text="Tạo thủ công"
        android:textAllCaps="false"
        android:textColor="@color/sm_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvDeckCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="12dp"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/sm_text_secondary"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/deckContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp" />

    </ScrollView>

</LinearLayout>