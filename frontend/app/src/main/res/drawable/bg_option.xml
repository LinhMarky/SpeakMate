<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sm_surface_light" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="@color/sm_cyan" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sm_surface" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/sm_border" />
        </shape>
    </item>

</selector>