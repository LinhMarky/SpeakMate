<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/sm_disabled_background" />

            <stroke
                android:width="1dp"
                android:color="@color/sm_border" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#CBE8DC" />

            <stroke
                android:width="2dp"
                android:color="@color/sm_primary" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/sm_primary_soft" />

            <stroke
                android:width="1dp"
                android:color="#A2CFBF" />
        </shape>
    </item>

</selector>