<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="oval">

            <solid android:color="#393653" />

            <stroke
                android:width="1dp"
                android:color="#625C86" />

        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="oval">

            <gradient
                android:angle="315"
                android:startColor="#69F5FF"
                android:centerColor="#557DFF"
                android:endColor="#D079FF" />

            <stroke
                android:width="3dp"
                android:color="#B6F8FF" />

        </shape>
    </item>

    <item>
        <shape android:shape="oval">

            <gradient
                android:angle="315"
                android:startColor="#12DDF1"
                android:centerColor="#4760F0"
                android:endColor="#AC48F4" />

            <stroke
                android:width="2dp"
                android:color="#8AEAFF" />

        </shape>
    </item>

</selector>